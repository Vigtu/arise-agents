{
  "name": "arise-agents",
  "description": "Shadow army of specialized subagents inspired by Solo Leveling. ARISE!",
  "version": "0.1.0",
  "author": {
    "name": "Vigtu"
  },
  "repository": "https://github.com/Vigtu/arise-agents",
  "license": "MIT",
  "commands": [
    "./commands/arise.md",
    "./commands/domain.md",
    "./commands/equip.md",
    "./commands/extract.md",
    "./commands/shadows.md",
    "./commands/status.md"
  ],
  "agents": [
    "./agents/igris.md",
    "./agents/igris.ascended.md",
    "./agents/beru.md",
    "./agents/beru.ascended.md",
    "./agents/tusk.md",
    "./agents/soldier.md",
    "./agents/soldier.ascended.md"
  ],
  "skills": [
    "./skills/monarch",
    "./skills/tasks"
  ],
  "outputStyles": [
    "./output-styles/shadow-monarch.md"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/xp-hook.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
